<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot parent: manages versions of Spring, Jackson, logging and plugins -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.conceptgraph</groupId>
    <artifactId>conceptgraph-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ConceptGraph (parent)</name>

    <modules>
        <!-- Neo4j in its own JVM (POC 6). Kept out of tutor's classpath: Neo4j brings its own libraries. -->
        <module>graph-server</module>
        <module>tutor</module>
    </modules>

    <properties>
        <!-- Needs JDK 25. With only JDK 21 installed, build with: mvn -q package -DskipTests -Djava.version=21 -->
        <java.version>25</java.version>
        <langchain4j.version>1.22.0</langchain4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- The BOM keeps every langchain4j-* artifact on the same version -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
